generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id             String          @id @default(cuid())
  name           String?
  discordId      String          @unique
  image          String?
  twitchId       String?
  twitchUsername String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  referralCode   String?
  referrerId     String?
  accounts       Account[]
  Challenges     Challenge[]
  Message        Message[]
  Participations Participation[]
  sessions       Session[]
  wallets        Wallet[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Wallet {
  id             String          @id @default(cuid())
  address        String          @unique
  userId         String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  participations Participation[]
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Challenge {
  id                             String          @id @default(cuid())
  challengeCreator               String
  challengeAddress               String          @unique
  gameId                         Int
  platformId                     Int
  nbTeams                        Int
  nbTeamPlayers                  Int
  startAt                        DateTime
  isPrivate                      Boolean
  state                          ChallengeState
  txHash                         String          @unique(map: "challenge_tx_hash_unique")
  blockNumber                    BigInt
  delayEndDisputeParticipation   Int
  delayEndVictoryClaim           Int
  delayStartDisputeParticipation Int
  delayStartVictoryClaim         Int
  entryFee                       Float
  feePercentageDispute           Float
  pool                           Float
  winnerTeam                     Int?
  winnersClaimedCount            Int
  creator                        User            @relation(fields: [challengeCreator], references: [id], onDelete: Cascade)
  game                           Game            @relation(fields: [gameId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "challenge_game_fk")
  platform                       Platform        @relation(fields: [platformId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "challenge_platform_fk")
  messages                       Message[]
  participations                 Participation[]
}

model Participation {
  id          String    @id @default(cuid())
  userId      String
  challengeId String
  walletId    String
  teamId      Int
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet      Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([challengeId, walletId])
}

model Message {
  id          String    @id @default(cuid())
  content     String
  createdAt   DateTime  @default(now())
  challengeId String
  userId      String
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
}

model Game {
  id          Int         @id @default(autoincrement())
  name        String
  txHash      String      @unique(map: "game_tx_hash_unique")
  blockNumber BigInt?
  Challenge   Challenge[]
}

model Platform {
  id          Int         @id @default(autoincrement())
  name        String
  txHash      String      @unique(map: "platform_tx_hash_unique")
  blockNumber BigInt
  Challenge   Challenge[]
}

model Mode {
  id          Int     @id @default(autoincrement())
  name        String
  txHash      String  @unique(map: "mode_tx_hash_unique")
  blockNumber BigInt?
}

enum ChallengeState {
  CREATED
  FINISHED
}
